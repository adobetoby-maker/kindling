    {
      "index": 148,
      "text": "\"It might just be the one that doesn't.\"",
      "audioSha256": "250e65b826fe184151444bd7572d11694789d88d66591ff0632db97145555548"
    },
    {
      "index": 226,
      "text": "\"I know.\"",
      "audioSha256": "9524c96518bfb5560e9d4024b3a1af31e60c2c6a01984681197a7901ba380266"
    },
    {
      "index": 241,
