      "index": 451,
      "text": "\"Don't.",
      "audioSha256": "3f94bec9b45e3df4508b4a80f70e3fa1468a544f0de78f7210a9cc1ca2cd296b"
    },
    {
      "index": 463,
      "text": "She could not go far.",
      "audioSha256": "fe3ede46a0c6e71bb4d23063352ee732d3381c06ab1714b04fa2643da35b32cf"
    },
    {
      "index": 493,
